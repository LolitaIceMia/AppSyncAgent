<Window x:Class="ToolSyncAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToolSyncAgent"
        mc:Ignorable="d"
        Title="ToolSync Agent" Height="450" Width="800">
    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="添加新软件" Width="100" Height="30"
                    FontSize="14"
                    Command="{Binding AddPackageCommand}"/>
        </StackPanel>

        <ListView ItemsSource="{Binding Packages}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="软件名称" Width="150" DisplayMemberBinding="{Binding MD5}" />
                    <GridViewColumn Header="当前版本" Width="100" DisplayMemberBinding="{Binding CurrentVersion}" />
                    <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="最后更新时间" Width="200" DisplayMemberBinding="{Binding LastCheckedTime}" />
                    <GridViewColumn Header="操作" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="检查更新" Width="80" Height="25"
                                        Command="{Binding DataContext.CheckForUpdatesCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
