<Window x:Class="ToolSyncAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToolSyncAgent"
        mc:Ignorable="d"
        Title="ToolSync Agent" Height="450" Width="800">

    <DockPanel Margin="10">

        <Button DockPanel.Dock="Bottom"
                Content="添加一个新软件 (PowerToys)"
                Margin="0,10,0,0"
                Height="30"
                FontSize="14"
                FontWeight="Bold"
                Command="{Binding AddPackageCommand}"/>
        <ListView ItemsSource="{Binding Packages}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="软件名称" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="当前版本" Width="150" DisplayMemberBinding="{Binding CurrentVersion}" />
                    <GridViewColumn Header="状态" Width="150" DisplayMemberBinding="{Binding Status}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>